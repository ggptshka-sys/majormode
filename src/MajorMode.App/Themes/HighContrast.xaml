<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Режим высокой контрастности Windows: системные шаблоны и цвета. Те же ключи стилей, что и в Dark.xaml.
         Кисти Brush.* добавляет ThemeManager из SystemColors. -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="PreviewInset" TargetType="Border">
        <Setter Property="Background" Value="#111111" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,1" />
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="SegmentTrack" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource StrongFocusVisual}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="ReadOnlyText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource StrongFocusVisual}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource StrongFocusVisual}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="Margin" Value="0,4,0,8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource StrongFocusVisual}" />
        <Setter Property="Margin" Value="0,4,18,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="Padding" Value="0,6,0,2" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
        <Setter Property="Margin" Value="0,6,0,4" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style x:Key="InlineGroupBox" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
        <Setter Property="Margin" Value="0,6,0,4" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
</ResourceDictionary>
