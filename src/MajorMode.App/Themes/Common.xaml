<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Общие ресурсы обеих тем. Цвета берутся из ключей Brush.*, которые задает активная тема (ThemeManager). -->

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Цвета маркеров пальцев, как на картинке (MarkerPalette). В интерфейсе только украшение рядом с текстом. -->
    <SolidColorBrush x:Key="Brush.Finger1" Color="#D32F2F" />
    <SolidColorBrush x:Key="Brush.Finger2" Color="#F57C00" />
    <SolidColorBrush x:Key="Brush.Finger3" Color="#FDD835" />
    <SolidColorBrush x:Key="Brush.Finger4" Color="#2E7D32" />

    <Style x:Key="StrongFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" StrokeThickness="2" RadiusX="7" RadiusY="7" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Brush.Focus}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Цвет не единственный признак: текст всегда содержит слово "Ошибка" или "Предупреждение". -->
    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,4" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,6" />
    </Style>

    <Style x:Key="SectionCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="2,4,0,6" />
    </Style>
</ResourceDictionary>
