<Window x:Class="MajorMode.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:parsing="clr-namespace:MajorMode.Core.Parsing;assembly=MajorMode.Core"
        Title="MajorMode — картинки аккордов"
        Icon="Assets/majormode.ico"
        Width="1360" Height="900" MinWidth="1000" MinHeight="640"
        FontSize="15" FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding ChooseFolderCommand}" />
    </Window.InputBindings>

    <!-- Строка состояния объявлена последней: по Tab ссылка обновлений идет после всех полей формы. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Margin="16,14,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="0.55*" MinWidth="220" MaxWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Форма. Порядок элементов = порядок Tab. Карточки (Border) фокус не получают. -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" IsTabStop="False" Padding="0,0,14,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionCaption}" Text="АККОРД" />
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <Label Content="_Название аккорда" Target="{Binding ElementName=ChordNameBox}" Padding="0,0,0,4" />
                            <TextBox x:Name="ChordNameBox" FontSize="17" FontWeight="SemiBold"
                                     Text="{Binding ChordName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Название аккорда"
                                     AutomationProperties.HelpText="{Binding ChordNameHelp}" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                       Text="Чтобы пропустить палец, введите 0 в оба поля. Для баррэ первым пальцем введите латинскую B в поле «струна»." />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionCaption}" Text="ПАЛЬЦЫ" Margin="2,8,0,6" />

                    <!-- Палец 1 -->
                    <GroupBox Header="Палец 1" Tag="{StaticResource Brush.Finger1}" DataContext="{Binding Fingers[0]}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label Content="Палец _1: лад" Target="{Binding ElementName=Finger1Fret}" />
                                    <TextBox x:Name="Finger1Fret" MaxLength="3"
                                             Text="{Binding Fret, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding FretLabel}"
                                             AutomationProperties.HelpText="{Binding FretHelp}"
                                             AutomationProperties.ItemStatus="{Binding FretError}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Струна или B" Target="{Binding ElementName=Finger1String}" />
                                    <TextBox x:Name="Finger1String" MaxLength="2"
                                             Text="{Binding GuitarString, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding StringLabel}"
                                             AutomationProperties.HelpText="{Binding StringHelp}"
                                             AutomationProperties.ItemStatus="{Binding StringError}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding FretError}" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding StringError}" />
                        </StackPanel>
                    </GroupBox>

                    <!-- Палец 2 -->
                    <GroupBox Header="Палец 2" Tag="{StaticResource Brush.Finger2}" DataContext="{Binding Fingers[1]}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label Content="Палец _2: лад" Target="{Binding ElementName=Finger2Fret}" />
                                    <TextBox x:Name="Finger2Fret" MaxLength="3"
                                             Text="{Binding Fret, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding FretLabel}"
                                             AutomationProperties.HelpText="{Binding FretHelp}"
                                             AutomationProperties.ItemStatus="{Binding FretError}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Струна" Target="{Binding ElementName=Finger2String}" />
                                    <TextBox x:Name="Finger2String" MaxLength="2"
                                             Text="{Binding GuitarString, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding StringLabel}"
                                             AutomationProperties.HelpText="{Binding StringHelp}"
                                             AutomationProperties.ItemStatus="{Binding StringError}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding FretError}" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding StringError}" />
                        </StackPanel>
                    </GroupBox>

                    <!-- Палец 3 -->
                    <GroupBox Header="Палец 3" Tag="{StaticResource Brush.Finger3}" DataContext="{Binding Fingers[2]}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label Content="Палец _3: лад" Target="{Binding ElementName=Finger3Fret}" />
                                    <TextBox x:Name="Finger3Fret" MaxLength="3"
                                             Text="{Binding Fret, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding FretLabel}"
                                             AutomationProperties.HelpText="{Binding FretHelp}"
                                             AutomationProperties.ItemStatus="{Binding FretError}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Струна" Target="{Binding ElementName=Finger3String}" />
                                    <TextBox x:Name="Finger3String" MaxLength="2"
                                             Text="{Binding GuitarString, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding StringLabel}"
                                             AutomationProperties.HelpText="{Binding StringHelp}"
                                             AutomationProperties.ItemStatus="{Binding StringError}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding FretError}" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding StringError}" />
                        </StackPanel>
                    </GroupBox>

                    <!-- Палец 4 -->
                    <GroupBox Header="Палец 4" Tag="{StaticResource Brush.Finger4}" DataContext="{Binding Fingers[3]}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label Content="Палец _4: лад" Target="{Binding ElementName=Finger4Fret}" />
                                    <TextBox x:Name="Finger4Fret" MaxLength="3"
                                             Text="{Binding Fret, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding FretLabel}"
                                             AutomationProperties.HelpText="{Binding FretHelp}"
                                             AutomationProperties.ItemStatus="{Binding FretError}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Струна" Target="{Binding ElementName=Finger4String}" />
                                    <TextBox x:Name="Finger4String" MaxLength="2"
                                             Text="{Binding GuitarString, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding StringLabel}"
                                             AutomationProperties.HelpText="{Binding StringHelp}"
                                             AutomationProperties.ItemStatus="{Binding StringError}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding FretError}" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding StringError}" />
                        </StackPanel>
                    </GroupBox>

                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <Label Content="_Заглушенные струны" Target="{Binding ElementName=MutedBox}" Padding="0,0,0,4" />
                            <TextBox x:Name="MutedBox"
                                     Text="{Binding MutedStrings, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Заглушенные струны"
                                     AutomationProperties.HelpText="{Binding MutedHelp}"
                                     AutomationProperties.ItemStatus="{Binding MutedError}" />
                            <TextBlock Style="{StaticResource HintText}" Text="{x:Static parsing:MutedStringsParser.HelpText}" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding MutedError}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionCaption}" Text="ОФОРМЛЕНИЕ" Margin="2,8,0,6" />
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <GroupBox Header="Ориентация грифа" Style="{DynamicResource InlineGroupBox}">
                                <Border Style="{DynamicResource SegmentTrack}">
                                    <UniformGrid Rows="1"
                                                 KeyboardNavigation.DirectionalNavigation="Cycle"
                                                 KeyboardNavigation.TabNavigation="Once">
                                        <RadioButton Content="_Вертикально" GroupName="Orientation" Margin="0,0,2,0"
                                                     IsChecked="{Binding IsVertical}"
                                                     GotKeyboardFocus="RadioButton_GotKeyboardFocus"
                                                     AutomationProperties.Name="Ориентация грифа: вертикально"
                                                     AutomationProperties.HelpText="Слева 6 струна, справа 1. Лады растут сверху вниз. Стрелки переключают ориентацию." />
                                        <RadioButton Content="_Горизонтально" GroupName="Orientation" Margin="2,0,0,0"
                                                     IsChecked="{Binding IsHorizontal}"
                                                     GotKeyboardFocus="RadioButton_GotKeyboardFocus"
                                                     AutomationProperties.Name="Ориентация грифа: горизонтально"
                                                     AutomationProperties.HelpText="Снизу 6 струна, сверху 1. Лады растут слева направо. Стрелки переключают ориентацию." />
                                    </UniformGrid>
                                </Border>
                            </GroupBox>

                            <Label Content="_Холст" Target="{Binding ElementName=CanvasBox}" />
                            <ComboBox x:Name="CanvasBox"
                                      ItemsSource="{Binding CanvasOptions}" DisplayMemberPath="Name"
                                      SelectedValuePath="Value" SelectedValue="{Binding Canvas}"
                                      AutomationProperties.Name="Холст"
                                      AutomationProperties.HelpText="Соотношение сторон и размер картинки. Не зависит от ориентации грифа. Стрелки вверх и вниз меняют выбор." />

                            <Label Content="Сти_ль изображения" Target="{Binding ElementName=StyleBox}" />
                            <ComboBox x:Name="StyleBox"
                                      ItemsSource="{Binding StyleOptions}" DisplayMemberPath="Name"
                                      SelectedValuePath="Value" SelectedValue="{Binding Style}"
                                      AutomationProperties.Name="Стиль изображения"
                                      AutomationProperties.HelpText="Меняет только оформление, аппликатура и цифры пальцев остаются теми же." />

                            <Label Content="_Формат" Target="{Binding ElementName=FormatBox}" />
                            <ComboBox x:Name="FormatBox" Margin="0,0,0,2"
                                      ItemsSource="{Binding FormatOptions}" DisplayMemberPath="Name"
                                      SelectedValuePath="Value" SelectedValue="{Binding Format}"
                                      AutomationProperties.Name="Формат файла"
                                      AutomationProperties.HelpText="GIF — основной формат, статический один кадр. PNG без потерь. JPG с высоким качеством." />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionCaption}" Text="ЭКСПОРТ" Margin="2,8,0,6" />
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <Label Content="_Имя файла" Target="{Binding ElementName=FileNameBox}" Padding="0,0,0,4" />
                            <TextBox x:Name="FileNameBox"
                                     Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Имя файла"
                                     AutomationProperties.HelpText="{Binding FileNameHelp}" />
                            <TextBlock Style="{StaticResource HintText}">
                                <Run Text="Будет сохранено как:" />
                                <Run Text="{Binding EffectiveFileName, Mode=OneWay}" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Brush.Text}" />
                            </TextBlock>

                            <Label Content="Текущий путь" Target="{Binding ElementName=FolderBox}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderBox" Style="{DynamicResource ReadOnlyText}"
                                         Text="{Binding OutputFolder, Mode=OneWay}"
                                         AutomationProperties.Name="Текущий путь"
                                         AutomationProperties.HelpText="Папка, куда сохраняется картинка. Изменить: кнопка Выбор пути, она следующая по Tab." />
                                <Button Grid.Column="1" Content="Выбор _пути…" Command="{Binding ChooseFolderCommand}"
                                        Margin="8,0,0,4" VerticalAlignment="Top" MinHeight="38"
                                        AutomationProperties.Name="Выбор пути"
                                        AutomationProperties.HelpText="Открывает системный диалог выбора папки для сохранения. Горячая клавиша Ctrl+O." />
                            </Grid>

                            <Button x:Name="SaveButton" Content="_Сохранить" Command="{Binding SaveCommand}" Style="{DynamicResource AccentButton}"
                                    AutomationProperties.Name="Сохранить"
                                    AutomationProperties.HelpText="Сохраняет картинку в выбранную папку. Горячая клавиша Ctrl+S. Результат будет объявлен." />

                            <TextBox Style="{DynamicResource ReadOnlyText}" Text="{Binding StatusMessage, Mode=OneWay}"
                                     Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}"
                                     AutomationProperties.Name="Результат сохранения" />
                            <TextBox Style="{DynamicResource ReadOnlyText}" Text="{Binding ErrorSummary, Mode=OneWay}"
                                     Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}"
                                     AutomationProperties.Name="Сводка ошибок" />                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Превью: тот же bitmap, что уйдет в файл, просто масштабированный. -->
            <Border Grid.Column="1" Style="{DynamicResource Card}" Margin="0,0,12,10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Превью" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                        <Border Grid.Column="1" Style="{DynamicResource Chip}">
                            <TextBlock Style="{DynamicResource ChipText}" Text="{Binding PreviewCaption}" />
                        </Border>
                    </Grid>
                    <Border Style="{DynamicResource PreviewInset}">
                        <Grid>
                            <Image Source="{Binding Preview}" Stretch="Uniform" Margin="10"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="Превью картинки аккорда"
                                   AutomationProperties.HelpText="{Binding Description}" />
                            <Border Background="#E6101216" Padding="16,12" CornerRadius="10" Margin="12"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Foreground="White" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                                           Text="Превью не обновлено: в аккорде есть ошибки. Список ошибок — в форме слева." />
                            </Border>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource Card}" Margin="0,0,0,10">
                <DockPanel>
                    <Label DockPanel.Dock="Top" Content="_Описание аккорда" Target="{Binding ElementName=DescriptionBox}"
                           Padding="0,0,0,8" FontSize="15" />
                    <TextBox x:Name="DescriptionBox" Style="{DynamicResource ReadOnlyText}"
                             Text="{Binding Description, Mode=OneWay}"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Описание аккорда"
                             AutomationProperties.HelpText="Полное текстовое описание картинки. Обновляется через долю секунды после ввода и не объявляется автоматически." />
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="0" Background="{DynamicResource Brush.Header}"
                BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="0,0,0,1" Padding="18,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <!-- Логотип: контуры из Assets/majormode.svg. -->
                    <Viewbox Width="40" Height="40" VerticalAlignment="Center">
                        <Canvas Width="1024" Height="1024">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform X="-512" Y="-506" />
                                    <ScaleTransform ScaleX="1.0933333333" ScaleY="1.0933333333" />
                                    <TranslateTransform X="512" Y="512" />
                                </TransformGroup>
                            </Canvas.RenderTransform>
                            <Path Fill="#38CCC0"
                                  Data="M512 131 C354 131 258 171 214 265 C180 337 198 413 227 493 C265 597 322 700 386 782 C438 849 474 881 512 881 C550 881 586 849 638 782 C702 700 759 597 797 493 C826 413 844 337 810 265 C766 171 670 131 512 131 Z" />
                            <Path Fill="#252726"
                                  Data="M356 305 H432 L512 474 L592 305 H668 V603 H602 V421 L525 584 H500 L422 421 V603 H356 Z" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="MajorMode" FontSize="18" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Строка состояния: состояние картинки, последнее объявление, версия и обновления.
             NVDA+End / Диктор+End читают ее целиком. -->
        <StatusBar Grid.Row="2" Focusable="False">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left" Focusable="False">
                <Button x:Name="ShareButton" Style="{DynamicResource LinkButton}"
                        Command="{Binding ShareCommand}"
                        AutomationProperties.Name="Поделиться"
                        AutomationProperties.HelpText="Открывает страницу проекта на GitHub в браузере и копирует ссылку на нее в буфер обмена. Alt+Д.">
                    <AccessText Text="По_делиться" TextDecorations="Underline" />
                </Button>
            </StatusBarItem>
            <Separator DockPanel.Dock="Left" Margin="10,2" Background="{DynamicResource Brush.CardBorder}" />
            <StatusBarItem DockPanel.Dock="Left" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{DynamicResource StateDot}" Width="8" Height="8" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" />
                </StackPanel>
            </StatusBarItem>
            <Separator DockPanel.Dock="Left" Margin="10,2" Background="{DynamicResource Brush.CardBorder}" />
            <StatusBarItem DockPanel.Dock="Right" Focusable="False">
                <Button x:Name="CheckUpdatesButton" Style="{DynamicResource LinkButton}"
                        Command="{Binding CheckUpdatesCommand}"
                        AutomationProperties.Name="Проверить обновления"
                        AutomationProperties.HelpText="Сверяет версию с последней на GitHub. Если есть новая, спросит подтверждение, скачает ее и перезапустит программу. Alt+Б.">
                    <AccessText Text="Проверить о_бновления" TextDecorations="Underline" />
                </Button>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" Focusable="False">
                <TextBlock Text="{Binding AppVersionText}" Foreground="{DynamicResource Brush.TextMuted}" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" Margin="10,2" Background="{DynamicResource Brush.CardBorder}" />
            <StatusBarItem Focusable="False">
                <TextBlock x:Name="AnnouncementText" TextWrapping="Wrap"
                           AutomationProperties.Name="Последнее сообщение"
                           AutomationProperties.LiveSetting="Polite" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
