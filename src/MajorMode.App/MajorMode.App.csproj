<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MajorMode</AssemblyName>
    <RootNamespace>MajorMode.App</RootNamespace>
    <Title>MajorMode — картинки аккордов</Title>
    <!-- Для single-file публикации нативная библиотека SkiaSharp распаковывается из exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Отладочные символы (включая 96 МБ libSkiaSharp.pdb) не нужны пользователю в папке публикации. -->
  <Target Name="RemovePdbAfterPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_MajorModePdb Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_MajorModePdb)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\MajorMode.Core\MajorMode.Core.csproj" />
    <ProjectReference Include="..\MajorMode.Rendering\MajorMode.Rendering.csproj" />
  </ItemGroup>

</Project>
